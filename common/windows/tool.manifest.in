<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  SPDX-License-Identifier: Apache-2.0
  Copyright © 2026 Norvitex OÜ

  Application manifest of @ABR_TOOL_NAME@.exe, generated from
  common/windows/tool.manifest.in by abr_add_tool(), once per tool.

  asInvoker: most commands need no rights beyond reaching the repository, so the
  tool never asks for elevation itself - requireAdministrator would make every
  start from a non-elevated caller fail with ERROR_ELEVATION_REQUIRED, list and
  info included. A command that does need an elevated token checks for one and
  says so.

  activeCodePage UTF-8 (Windows 10 1903 and later): the storage library opens its
  files by narrow paths, which Windows reads in the process's ANSI code page. The
  tool's strings are UTF-8 throughout, so this makes the two agree, and a
  repository folder or backup name outside the local code page still works.

  longPathAware: paths past MAX_PATH work wherever the system has long paths
  enabled.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
